{
  "expo": {
    "name": "Scheduly",
    "slug": "scheduly",
    "version": "1.0.0",
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "남은 할 일을 알려드리기 위해 알림을 사용합니다."
      }
    },
    "android": {
      "package": "com.scheduly"
    }
  }
}
